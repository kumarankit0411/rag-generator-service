APP_NAME=rag-generator
APP_ENV=dev
APP_PORT=8000
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
ASK_TOP_K=5
# global fallback; a docset's own calibrated value (stored in its Chroma collection
# metadata by scripts/calibrate.py --apply) takes precedence over this
ASK_MAX_DISTANCE=0.75
# any litellm model name; empty = extractive cited fallback, no API key needed
LLM_MODEL=
LLM_TEMPERATURE=0.0
EVAL_DIR=./evals